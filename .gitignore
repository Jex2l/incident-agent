# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*
!infra/kind/kind-config.yaml

# OS
.DS_Store

# Fault-script ground-truth records (generated per run, not committed in
# bulk) - but evals/results.json and evals/report.md ARE committed: they're
# the real eval harness deliverable (see docs/DECISIONS.md, Phase 7).
evals/runs/*.jsonl
evals/runs/*.json
!evals/runs/.gitkeep

# Traces
traces/*.json
traces/spans.jsonl
!traces/.gitkeep

# Executor state (generated, not committed in bulk)
executor/proposals.json
executor/audit.jsonl

# Helm
infra/helm-values/*.local.yaml

# Logs
*.log

# Node (replay site has no build step, but just in case)
node_modules/

# Model/data caches
*.gguf
*.bin
chroma/
*.sqlite3
