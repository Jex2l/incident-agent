# Helm
infra/helm-values/*.local.yaml

# Logs
*.log

# Node (replay site has no build step, but just in case)
node_modules/

# Model/data caches
*.gguf
*.bin
chroma/
*.sqlite3
!runbooks/runbooks.sqlite3.gitkeep
