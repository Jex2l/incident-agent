# Copy to .env and adjust. Never commit the real .env.
LLM_MODEL=qwen2.5:7b
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=/Volumes/JEX2L/ollama-models

KIND_CLUSTER_NAME=incident-agent
KUBECONFIG_CONTEXT=kind-incident-agent

PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100

# qwen2.5:7b on consumer hardware (no dedicated GPU) can take 30-150s per
# turn depending on context size; 120s was too tight to allow even a single
# multi-tool-call turn to complete, let alone a full investigation.
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS=16000
AGENT_WALLCLOCK_TIMEOUT_S=480

RUNBOOK_EMBED_MODEL=nomic-embed-text

EXECUTOR_URL=http://localhost:8020
